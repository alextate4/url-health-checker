{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HealthMonitor": "Data Source=healthmonitor.db"
  },
  "Monitor": {
    "TickSeconds": 5,
    "RequestTimeoutSeconds": 10,
    "MaxConcurrentChecks": 4,
    "RetentionSweepMinutes": 15
  }
}
