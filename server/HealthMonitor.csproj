<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <!-- Builds the React UI on a fresh clone, so one `dotnet run` works without committing built files. -->
  <Target Name="BuildWebUi" BeforeTargets="Build">
    <!-- npm ci installs exactly what package-lock.json lists and never rewrites it. -->
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/../web" Condition="!Exists('$(MSBuildProjectDirectory)/../web/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/../web" Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')" />
  </Target>

</Project>
